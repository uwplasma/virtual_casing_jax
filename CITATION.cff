        family-names: Gao
    repository-code: "https://github.com/dmalhotra/SCTL"
    license: Apache-2.0
    doi: "10.5281/zenodo.23511629"
    notes: "The Gauss-Legendre rule in singular_quadrature.py is translated from SCTL."
