        family-names: Cerfon
    repository-code: "https://github.com/hiddenSymmetries/virtual-casing"
    license: Apache-2.0
    doi: "10.5281/zenodo.23619289"
    notes: "virtual_casing.py, functional.py and testdata.py are translated from virtual-casing."
  - type: software
    title: "BIEST: Boundary Integral Equation Solver for Taylor states"
    authors:
      - given-names: Dhairya
        family-names: Malhotra
    repository-code: "https://github.com/dmalhotra/BIEST"
    license: Apache-2.0
    doi: "10.5281/zenodo.23511944"
    notes: "The singular quadrature, surface operators, kernels and off-surface evaluation are translated from BIEST."
  - type: software
    title: "SCTL: Scientific Computing Template Library"
