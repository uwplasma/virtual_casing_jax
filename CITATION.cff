cff-version: 1.2.0
message: "If you use virtual_casing_jax, please cite the software and the works it is translated from, listed below."
type: software
title: "virtual_casing_jax"
authors:
  - name: "UW Plasma"
  - given-names: Dhairya
    family-names: Malhotra
abstract: "A JAX translation of virtual-casing, and of the parts of BIEST and SCTL it uses, for computing the magnetic field due to plasma currents from the total field on a toroidal surface with high-order singular quadrature, with differentiable and batched evaluation."
repository-code: "https://github.com/uwplasma/virtual_casing_jax"
url: "https://virtual-casing-jax.readthedocs.io"
license: Apache-2.0
references:
  - type: software
    title: "virtual-casing: the virtual-casing principle on toroidal surfaces"
    authors:
      - given-names: Dhairya
        family-names: Malhotra
